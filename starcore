#!/data/data/com.termux/files/usr/bin/python3

import sys
import subprocess
from pathlib import Path


ROOT = Path.home() / "STARCORE"


def run_module(module, args):

    path = ROOT / module

    if not path.exists():

        print("MODULE NOT FOUND:")
        print(path)
        return 1

    return subprocess.call(
        [
            "python3",
            str(path),
            *args
        ]
    )


def main():

    if len(sys.argv) < 3:

        print("""
STARCORE Android CLI

Usage:

./starcore android status
./starcore android health
./starcore android help

""")

        return


    platform=sys.argv[1]
    command=sys.argv[2]


    if platform != "android":

        print("Only android platform supported")

        return


    routes={

    "status":
    "plugins/enabled/android/control_plane/modules/status.py",

    "health":
    "plugins/enabled/android/control_plane/modules/health.py"

    }


    if command in routes:

        run_module(
            routes[command],
            sys.argv[3:]
        )

    else:

        print(
        "Unknown command:",
        command
        )


if __name__=="__main__":

    main()

